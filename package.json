{
  "name": "proyecto-wayturismo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -n gateway,auth,places,geo,trips,client -c blue,green,yellow,magenta,cyan,gray \"npm run dev:gateway\" \"npm run dev:auth\" \"npm run dev:places\" \"npm run dev:geo\" \"npm run dev:trips\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:gateway": "node services/gateway/index.js",
    "dev:auth": "node services/auth-service/index.js",
    "dev:places": "node services/places-service/index.js",
    "dev:geo": "node services/geo-service/index.js",
    "dev:trips": "node services/trips-service/index.js",
    "dev:monolith": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "start": "node services/gateway/index.js",
    "start:monolith": "node server/index.js",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "preview": "vite preview",
    "postinstall": "node scripts/setup.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-leaflet": "^5.0.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10"
  }
}
